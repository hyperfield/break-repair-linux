#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

# shellcheck disable=SC1091
source "$REPO_ROOT/lib/common.sh"

required_files=(
  metadata.env
  prompt.md
  break.sh
  verify-broken.sh
  verify-fixed.sh
  hints.md
  solution.md
)

script_files=(
  break.sh
  verify-broken.sh
  verify-fixed.sh
  reset.sh
)

failures=0
count=0

while IFS= read -r -d '' metadata; do
  scenario_dir="$(dirname "$metadata")"
  count=$((count + 1))

  for file in "${required_files[@]}"; do
    [[ -f "$scenario_dir/$file" ]] || {
      warn "$scenario_dir is missing $file"
      failures=$((failures + 1))
    }
  done

  for file in "${script_files[@]}"; do
    [[ -f "$scenario_dir/$file" ]] || continue
    [[ -x "$scenario_dir/$file" ]] || {
      warn "$scenario_dir/$file is not executable"
      failures=$((failures + 1))
    }
  done
done < <(find "$REPO_ROOT/scenarios" -type f -name metadata.env -print0 | sort -z)

if [[ "$count" -eq 0 ]]; then
  info "no scenarios found yet"
  exit 0
fi

if [[ "$failures" -gt 0 ]]; then
  die "scenario check failed with $failures problem(s) across $count scenario(s)"
fi

info "checked $count scenario(s); no structural problems found"
